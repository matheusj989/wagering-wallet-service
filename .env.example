# Portas publicadas pelo Compose. Use 0 para porta efemera.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180
MINISTACK_PORT=4566
APP_PORT_RANGE=8080-8082

# Credenciais locais de desenvolvimento. Nao use em outro ambiente.
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8180
MIGRATE_DATABASE_URL=postgres://wallet_owner:wallet_owner@postgres:5432/wallet?sslmode=disable

# Aplicacao
APP_ENV=local
INSTANCE_ID=
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_WRITE_CONCURRENCY=12
HTTP_WRITE_QUEUE_TIMEOUT=2s
HTTP_MAX_BODY_BYTES=65536
SHUTDOWN_TIMEOUT=15s

# Banco (runtime usa o papel wallet_app)
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2
# Conexoes fora do orcamento dos componentes: leituras, health e encerramento.
# O start recusa quando HTTP_WRITE_CONCURRENCY + SQS_CONSUMER_WORKERS + jobs + DB_POOL_RESERVED passa de DB_POOL_MAX_CONNS.
DB_POOL_RESERVED=2
DB_LOCK_TIMEOUT=3s
DB_STATEMENT_TIMEOUT=5s
DB_RETRY_ATTEMPTS=3

# SQS (MiniStack local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo
SQS_INGESTION_PRINCIPAL=arn:aws:iam::000000000000:role/wager-ingestion
SQS_SERVICE_PRINCIPAL=arn:aws:iam::000000000000:role/wallet-service

# Consumidor
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_WORKERS=4
SQS_WAIT_TIME=20s
SQS_VISIBILITY_TIMEOUT=30s
SQS_MESSAGE_DEADLINE=10s
SQS_RETRY_BACKOFF_BASE=5s
SQS_RETRY_BACKOFF_MAX=5m
SQS_MAX_RECEIVE_COUNT=5

# Publisher da outbox
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m

# Worker de referencias pendentes
REFERENCE_WORKER_ENABLED=true
REFERENCE_POLL_INTERVAL=1s
REFERENCE_BATCH_SIZE=10
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=60s
REFERENCE_TTL=15m

# Keycloak. O issuer e publico e fixo; discovery e JWKS podem estar em outra rede.
OIDC_ISSUER=http://localhost:8180/realms/wallet
OIDC_DISCOVERY_URL=http://localhost:8180/realms/wallet
OIDC_JWKS_URL=http://localhost:8180/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

# Secrets dos clients de desenvolvimento importados no realm
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_SECRET=provider-b-secret
PROVIDER_C_CLIENT_SECRET=provider-c-secret
WALLET_INTERNAL_CLIENT_SECRET=wallet-internal-secret

# Failpoints: so tem efeito no binario compilado com -tags failpoints
FAILPOINT=
